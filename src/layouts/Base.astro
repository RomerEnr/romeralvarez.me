---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t, type Locale } from "../i18n";
import { SITE } from "../site";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string;
  /** The same page in other languages. Only languages listed here get an hreflang link. */
  alternates?: Partial<Record<Locale, string>>;
  jsonLd?: object;
  type?: "website" | "article";
}

const { locale, title = t(locale, "meta.title"), description = t(locale, "meta.description"), image, alternates = {}, jsonLd, type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url);
const ogLocale = { en: "en_US", it: "it_IT", es: "es_ES" }[locale];
// Pages without their own image share the localized card from public/og/ (1200x630).
const ogImage = new URL(image ?? `/og/${locale}.jpg`, SITE.url);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([l, path]) => <link rel="alternate" hreflang={l} href={new URL(path, SITE.url)} />)}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, SITE.url)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Romer Alvarez · Blog" href="/rss.xml" />
    <meta name="theme-color" content="#f2f3f5" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    {
      !image && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      import.meta.env.PROD && (
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={SITE.umami} data-domains="romeralvarez.me" />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">{t(locale, "skip")}</a>
    <Header locale={locale} alternates={alternates} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
