---
import Base from "../../../layouts/Base.astro";
import { t } from "../../../i18n";
import { formatDate, getPosts, postUrl } from "../../../lib/blog";

const posts = await getPosts("es");
---

<Base locale="es" title="Blog · Romer Alvarez" description={t("es", "blog.lead")} alternates={{ es: "/es/blog/" }}>
  <main class="wrap flowing">
    <span class="label">{t("es", "blog.title")}</span>
    <h1>{t("es", "blog.title")}</h1>
    <p class="lead">{t("es", "blog.lead")}</p>
    <ol class="posts">
      {
        posts.map((post) => (
          <li>
            <a href={postUrl(post)}>
              <time class="label" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, "es")}</time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

<style>
  main {
    padding-block: 72px 96px;
  }
  h1 {
    margin-top: 16px;
  }
  .lead {
    margin: 24px 0 56px;
    max-width: 40ch;
    font: 400 clamp(20px, 2.2vw, 26px)/1.35 var(--sans);
    color: var(--ink-muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .posts a {
    display: block;
    padding: 24px;
    background: var(--surface);
    border-radius: 16px;
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }
  .posts a:hover {
    transform: translateY(-3px);
  }
  .posts a:hover h2 {
    color: var(--pipeline-ink);
  }
  .posts h2 {
    margin: 10px 0 8px;
    font: 500 clamp(24px, 2.6vw, 32px)/1.15 var(--display);
    letter-spacing: -0.02em;
  }
  .posts p {
    margin: 0;
    color: var(--ink-muted);
    max-width: 70ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
