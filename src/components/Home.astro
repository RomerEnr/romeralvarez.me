---
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { locales, localePath, t, type Locale } from "../i18n";
import type { IconName } from "../lib/icons";
import { SITE } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const alternates = Object.fromEntries(locales.map((l) => [l, localePath(l)]));

// Each service shows a toy piece from the hero (public/models); the flat icon stays as the fallback.
const services: { icon: IconName; model: number; n: 1 | 2 | 3 }[] = [
  { icon: "product", model: 3, n: 1 },
  { icon: "tools", model: 2, n: 2 },
  { icon: "layers", model: 6, n: 3 },
];

// The path so far, oldest first. Each stop is a node on the line.
const path: { n: 1 | 2 | 3 | 4; tags: [string, IconName?][] }[] = [
  { n: 1, tags: [["Linux"], ["Azure"], ["Docker", "docker"]] },
  { n: 2, tags: [["Java"], ["Spring Boot"], ["Kafka"], ["PostgreSQL"]] },
  { n: 3, tags: [["AWS", "aws"], ["Kubernetes", "kubernetes"], ["Terraform", "terraform"], ["Grafana", "grafana"], ["Bedrock"]] },
  { n: 4, tags: [["Products"], ["Tools"], ["Platforms"]] },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: SITE.name,
    jobTitle: SITE.jobTitle,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    address: { "@type": "PostalAddress", addressLocality: "Alessandria", addressCountry: "IT" },
    sameAs: [SITE.github, SITE.linkedin],
    knowsAbout: ["AWS", "Kubernetes", "Terraform", "ArgoCD", "GitHub Actions", "OpenTelemetry", "Grafana"],
  },
};
---

<Base locale={locale} alternates={alternates} jsonLd={jsonLd}>
  <main id="top">
    <section class="hero">
      <div class="wrap">
        <div>
          <h1>{SITE.jobTitle}.</h1>
          <p class="lead" id="lead">{t(locale, "hero.lead")}</p>
        </div>
        <div class="stage" id="stage" role="img" aria-label={t(locale, "hero.stage")}>
          <canvas></canvas>
          <span class="label hint">01 · Commit</span>
        </div>
      </div>
    </section>

    <section class="block" id="services" data-node="90">
      <div class="wrap flowing">
        <h2>{t(locale, "services.title")}</h2>
        <div class="services">
          {
            services.map(({ icon, model, n }) => (
              <div class="service">
                <div class="glyph" data-icon={icon} data-model={model}>
                  <Icon name={icon} />
                </div>
                <h3>{t(locale, `services.${n}.title`)}</h3>
                <p>{t(locale, `services.${n}.text`)}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="block" id="path">
      <div class="wrap flowing">
        <h2>{t(locale, "path.title")}</h2>
        <ol class="stops">
          {
            path.map(({ n, tags }) => (
              <li class="stop" data-node="18">
                <span class="when">{t(locale, `path.${n}.when`)}</span>
                <div>
                  <h3>{t(locale, `path.${n}.title`)}</h3>
                  <p>{t(locale, `path.${n}.text`)}</p>
                  <ul class="tags">
                    {tags.map(([name, icon]) => (
                      <li>
                        {icon && <Icon name={icon} />}
                        {name}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="end" id="contact">
      <div class="wrap flowing">
        <h2>{t(locale, "end.title")}</h2>
        <p>{t(locale, "end.text")}</p>
        <a class="pill cta big" id="endcta" href={`mailto:${SITE.email}`}>{t(locale, "cta")}</a>
      </div>
    </section>

    <svg class="pipe" aria-hidden="true"><path></path></svg>
  </main>
</Base>

<script>
  import "../scripts/pipeline";

  // The 3D scenes pull in three.js, so they load only when their section comes into view.
  const lazy = (selector: string, load: () => Promise<unknown>) => {
    const el = document.querySelector(selector);
    if (!el) return;
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        io.disconnect();
        load();
      }
    }, { rootMargin: "200px" });
    io.observe(el);
  };
  lazy("#stage", () => import("../scripts/hero"));
  lazy("#services", () => import("../scripts/tokens"));
  lazy("#path", () => import("../scripts/path"));
</script>

<style>
  .hero .wrap {
    display: grid;
    gap: 32px;
    padding-block: 48px 32px;
  }
  @media (min-width: 960px) {
    .hero .wrap {
      grid-template-columns: 1fr 400px;
      align-items: start;
      padding-block: 72px 40px;
    }
  }
  .lead {
    margin: 24px 0 0;
    max-width: 30ch;
    font: 400 clamp(20px, 2.2vw, 28px)/1.35 var(--sans);
  }
  .stage {
    position: relative;
    border-radius: 16px;
    background: var(--ink);
    overflow: hidden;
    aspect-ratio: 5 / 4;
    max-width: 100%;
    cursor: grab;
    touch-action: pan-y;
  }
  .stage:active {
    cursor: grabbing;
  }
  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hint {
    position: absolute;
    left: 16px;
    bottom: 14px;
    color: #9aa0aa;
    pointer-events: none;
  }

  main {
    position: relative;
  }
  section.block {
    padding-block: 64px;
  }
  .services {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .services h3 {
    margin: 0 0 8px;
    font: 500 20px/1.3 var(--display);
  }
  .services p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .glyph {
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    display: grid;
    place-items: center;
  }
  .glyph :global(svg.ico) {
    width: 32px;
    height: 32px;
  }
  .glyph:global(.token) {
    width: 150px;
    height: 150px;
    margin: -24px 0 -8px -36px;
  }
  .glyph :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .stops {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    gap: 56px;
  }
  .stop {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .stop {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 32px;
    }
  }
  .when {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pipeline-ink);
    padding-top: 12px;
  }
  .stop h3 {
    margin: 0 0 8px;
    font: 500 clamp(26px, 3vw, 36px)/1.15 var(--display);
    letter-spacing: -0.02em;
  }
  .stop p {
    margin: 0 0 16px;
    color: var(--ink-muted);
    max-width: 52ch;
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--surface);
    border-radius: 6px;
    padding: 8px 10px;
  }
  .tags :global(svg.ico) {
    width: 14px;
    height: 14px;
  }

  .end {
    padding-block: 96px 64px;
  }
  .end h2 {
    margin-bottom: 32px;
  }
  .end p {
    color: var(--ink-muted);
    max-width: 46ch;
    margin: 0 0 32px;
  }

  svg.pipe {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 1;
  }
  svg.pipe :global(path) {
    fill: none;
    stroke: var(--pipeline);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  svg.pipe :global(circle) {
    fill: var(--pipeline);
    stroke: var(--paper);
    stroke-width: 3;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.45s var(--ease);
  }
  svg.pipe :global(circle.off) {
    transform: scale(0);
  }
</style>
