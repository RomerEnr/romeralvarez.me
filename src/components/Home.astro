---
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { locales, localePath, t, type Locale } from "../i18n";
import type { IconName } from "../lib/icons";
import { SITE } from "../site";
import { formatDate, getPosts, postSlug, postUrl } from "../lib/blog";
import { Image } from "astro:assets";
import photo from "../assets/romer.png";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const alternates = Object.fromEntries(locales.map((l) => [l, localePath(l)]));

// Each service shows a toy piece from the hero (public/models); the flat icon stays as the fallback.
const services: { icon: IconName; model: number; n: 1 | 2 | 3 }[] = [
  { icon: "product", model: 3, n: 1 },
  { icon: "tools", model: 2, n: 2 },
  { icon: "layers", model: 6, n: 3 },
];

// The path so far, oldest first. Each stop is a node on the line.
const path: { n: 1 | 2 | 3 | 4; tags: [string, IconName?][] }[] = [
  { n: 1, tags: [["Linux"], ["Azure"], ["Docker", "docker"]] },
  { n: 2, tags: [["Java"], ["Spring Boot"], ["Kafka"], ["PostgreSQL"]] },
  { n: 3, tags: [["AWS", "aws"], ["Kubernetes", "kubernetes"], ["Terraform", "terraform"], ["Grafana", "grafana"], ["Bedrock"]] },
  { n: 4, tags: [["English"], ["Italiano"], ["Español"]] },
];

// The latest articles. They are written in Spanish, whatever the page language.
const posts = (await getPosts("es")).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: SITE.name,
    jobTitle: SITE.jobTitle,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    address: { "@type": "PostalAddress", addressLocality: "Alessandria", addressCountry: "IT" },
    sameAs: [SITE.github, SITE.linkedin],
    knowsAbout: ["AWS", "Kubernetes", "Terraform", "ArgoCD", "GitHub Actions", "OpenTelemetry", "Grafana"],
  },
};
---

<Base locale={locale} alternates={alternates} jsonLd={jsonLd}>
  <main id="top">
    <section class="hero">
      <div class="wrap">
        <div>
          <h1>{t(locale, "hero.title")}</h1>
          <p class="lead">{t(locale, "hero.lead")}</p>
          <p class="status" id="lead">{t(locale, "hero.status")}</p>
        </div>
        <div class="stage" id="stage">
          <canvas role="img" aria-label={t(locale, "hero.stage")}></canvas>
          <span class="label hint" aria-hidden="true">01 · Commit</span>
          <button class="play" type="button" hidden aria-label={t(locale, "hero.pause")} data-pause={t(locale, "hero.pause")} data-play={t(locale, "hero.play")}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path><path class="i-play" d="M8 5l11 7-11 7z"></path></svg>
          </button>
        </div>
      </div>
    </section>

    <section class="block" id="services" data-node="90">
      <div class="wrap flowing">
        <h2>{t(locale, "services.title")}</h2>
        <div class="services">
          {
            services.map(({ icon, model, n }) => (
              <div class="service">
                <div class="glyph" data-icon={icon} data-model={model}>
                  <Icon name={icon} />
                </div>
                <h3>{t(locale, `services.${n}.title`)}</h3>
                <p>{t(locale, `services.${n}.text`)}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="block" id="path">
      <div class="wrap flowing">
        <div class="path-head">
          <h2>{t(locale, "path.title")}</h2>
          <figure class="portrait">
            <span class="disc" aria-hidden="true"></span>
            <Image src={photo} alt={SITE.name} widths={[360, 720]} sizes="(min-width: 900px) 360px, 240px" />
          </figure>
        </div>
        <ol class="stops">
          {
            path.map(({ n, tags }) => (
              <li class="stop" data-node="18">
                <span class="when">{t(locale, `path.${n}.when`)}</span>
                <div>
                  <h3>{t(locale, `path.${n}.title`)}</h3>
                  <p>{t(locale, `path.${n}.text`)}</p>
                  <ul class="tags">
                    {tags.map(([name, icon]) => (
                      <li>
                        {icon && <Icon name={icon} />}
                        {name}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="block" id="writing" data-node="90">
      <div class="wrap flowing">
        <h2>{t(locale, "writing.title")}</h2>
        <p class="intro">{t(locale, "writing.text")}</p>
        <ul class="posts">
          {
            posts.map((post) => (
              <li>
                <a href={postUrl(post)} hreflang="es" data-umami-event="article" data-umami-event-slug={postSlug(post)}>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
                  <span>{post.data.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="more" href="/es/blog/" hreflang="es" data-umami-event="all-articles">{t(locale, "writing.all")} →</a>
      </div>
    </section>

    <section class="end" id="contact">
      <div class="wrap flowing">
        <h2>{t(locale, "end.title")}</h2>
        <p>{t(locale, "end.text")}</p>
        <div class="reach">
          <a class="pill cta big" id="endcta" href={`mailto:${SITE.email}`} data-umami-event="email" data-umami-event-place="contact">{t(locale, "cta")}</a>
          <span class="email">
            <span>{SITE.email}</span>
            <button type="button" class="copy" data-copied={t(locale, "end.copied")} data-umami-event="copy-email">{t(locale, "end.copy")}</button>
          </span>
        </div>
        <p class="elsewhere">
          <a href={SITE.linkedin} rel="me" data-umami-event="profile" data-umami-event-network="linkedin" data-umami-event-place="contact">LinkedIn</a>
          <a href={SITE.github} rel="me" data-umami-event="profile" data-umami-event-network="github" data-umami-event-place="contact">GitHub</a>
        </p>
      </div>
    </section>

    <svg class="pipe" aria-hidden="true"><path></path></svg>
  </main>
</Base>

<script>
  import "../scripts/pipeline";
  import "../scripts/reveal";

  // The 3D scenes pull in three.js, so they load only when their section comes into view.
  const lazy = (selector: string, load: () => Promise<unknown>) => {
    const el = document.querySelector(selector);
    if (!el) return;
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        io.disconnect();
        load();
      }
    }, { rootMargin: "200px" });
    io.observe(el);
  };
  lazy("#stage", () => Promise.all([import("../scripts/hero"), import("../scripts/rider")]));
  lazy("#services", () => import("../scripts/tokens"));
  lazy("#path", () => import("../scripts/path"));

  // Copy the email for people whose browser has no mail app behind mailto.
  const copy = document.querySelector<HTMLButtonElement>("#contact .copy");
  copy?.addEventListener("click", async () => {
    const email = copy.previousElementSibling!.textContent!;
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      getSelection()?.selectAllChildren(copy.previousElementSibling!);
      return;
    }
    const label = copy.textContent;
    copy.textContent = copy.dataset.copied!;
    setTimeout(() => (copy.textContent = label), 2000);
  });
</script>

<style>
  .hero .wrap {
    display: grid;
    gap: 32px;
    padding-block: 48px 32px;
  }
  @media (min-width: 960px) {
    .hero .wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
      align-items: start;
      padding-block: 72px 40px;
    }
  }
  .lead {
    margin: 24px 0 0;
    max-width: 30ch;
    font: 400 clamp(20px, 2.2vw, 28px)/1.35 var(--sans);
    text-wrap: pretty;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    font-size: 15px;
    color: var(--ink-muted);
  }
  .status::before {
    content: "";
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--pipeline);
    box-shadow: 0 0 0 4px var(--pipeline-soft);
  }
  .stage {
    position: relative;
    border-radius: 16px;
    background: var(--ink);
    overflow: hidden;
    aspect-ratio: 5 / 4;
    max-width: 100%;
    touch-action: pan-y;
  }
  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hint {
    position: absolute;
    left: 16px;
    bottom: 14px;
    color: #9aa0aa;
    pointer-events: none;
  }
  .play {
    position: absolute;
    right: 10px;
    bottom: 8px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #c9ccd2;
    cursor: pointer;
    transition: background 0.2s var(--ease);
  }
  .play:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .play:focus-visible {
    outline-color: var(--pipeline);
  }
  .play svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .play .i-play,
  .play[aria-pressed="true"] .i-pause {
    display: none;
  }
  .play[aria-pressed="true"] .i-play {
    display: inline;
  }

  main {
    position: relative;
  }
  section.block {
    padding-block: 64px;
  }
  .services {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .services h3 {
    margin: 0 0 8px;
    font: 500 20px/1.3 var(--display);
  }
  .services p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .glyph {
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    display: grid;
    place-items: center;
  }
  .glyph :global(svg.ico) {
    width: 32px;
    height: 32px;
  }
  .glyph:global(.token) {
    width: 150px;
    height: 150px;
    margin: -24px 0 -8px -36px;
  }
  .glyph :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Titles split into words by reveal.ts. The extra padding keeps descenders out of the clip. */
  :global(h2.rise .word) {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    vertical-align: top;
  }
  :global(h2.rise .word > span) {
    display: inline-block;
    transform: translateY(105%);
    opacity: 0;
    filter: blur(6px);
    transition:
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.9s ease-out,
      filter 0.9s ease-out;
  }
  :global(h2.rise.in .word > span) {
    transform: none;
    opacity: 1;
    filter: none;
  }
  .path-head {
    display: grid;
    gap: 24px;
  }
  .path-head h2 {
    margin: 0;
  }
  /* The character stands on the bottom edge of its frame, over an orange disc; path.ts raises it on scroll. */
  .portrait {
    position: relative;
    width: 240px;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    order: -1;
    border-bottom: 2px solid var(--pipeline);
  }
  .disc {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -10%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--pipeline-soft);
  }
  .portrait :global(img) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
  }
  @media (min-width: 900px) {
    .path-head {
      grid-template-columns: minmax(0, 1fr) 360px;
      align-items: end;
      gap: 32px;
    }
    .portrait {
      width: 360px;
      order: 0;
    }
  }
  .stops {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    gap: 56px;
  }
  .stop {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .stop {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 32px;
    }
  }
  .when {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pipeline-ink);
    padding-top: 12px;
  }
  .stop h3 {
    text-wrap: balance;
    margin: 0 0 8px;
    font: 500 clamp(26px, 3vw, 36px)/1.15 var(--display);
    letter-spacing: -0.02em;
  }
  .stop p {
    text-wrap: pretty;
    margin: 0 0 16px;
    color: var(--ink-muted);
    max-width: 52ch;
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--surface);
    border-radius: 6px;
    padding: 8px 10px;
  }
  .tags :global(svg.ico) {
    width: 14px;
    height: 14px;
  }

  .intro {
    margin: -16px 0 32px;
    color: var(--ink-muted);
    max-width: 52ch;
  }
  .posts {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .posts a {
    display: grid;
    gap: 6px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  @media (min-width: 900px) {
    .posts a {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 32px;
      align-items: baseline;
    }
  }
  .posts time {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .posts span {
    font: 500 clamp(20px, 2vw, 26px)/1.25 var(--display);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .posts a:hover span {
    color: var(--pipeline-ink);
  }
  .more {
    font-weight: 500;
  }

  .end {
    padding-block: 96px 64px;
  }
  .end h2 {
    margin-bottom: 32px;
  }
  .end p {
    color: var(--ink-muted);
    max-width: 46ch;
    margin: 0 0 32px;
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .email {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
  }
  .copy {
    font: 500 14px/1 var(--sans);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--line-strong);
  }
  .end .elsewhere {
    display: flex;
    gap: 24px;
    margin: 32px 0 0;
  }
  .elsewhere a {
    color: var(--ink);
    font-weight: 500;
  }

  main :global(canvas.rider) {
    position: absolute;
    left: 0;
    top: 0;
    width: 88px;
    height: 88px;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
  }
  svg.pipe {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 1;
  }
  svg.pipe :global(path) {
    fill: none;
    stroke: var(--pipeline);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  svg.pipe :global(circle) {
    fill: var(--pipeline);
    stroke: var(--paper);
    stroke-width: 3;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.45s var(--ease);
  }
  svg.pipe :global(circle.off) {
    transform: scale(0);
  }
</style>
