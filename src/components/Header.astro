---
import { locales, localePath, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** Where each language switch leads. Languages without this page go to their home. */
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const home = localePath(locale);
const links = [
  { href: `${home}#services`, label: t(locale, "nav.services") },
  { href: `${home}#path`, label: t(locale, "nav.path") },
  { href: `${home}#writing`, label: t(locale, "nav.writing") },
  { href: `${home}#contact`, label: t(locale, "nav.contact") },
];
---

<header>
  <div class="wrap">
    <a class="brand" href={home}>Romer Alvarez</a>
    <nav class="actions" aria-label={t(locale, "nav.label")}>
      <div class="langs" role="group" aria-label={t(locale, "langs.label")}>
        {
          locales.map((l) => (
            <a href={alternates[l] ?? localePath(l)} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined} data-umami-event="language" data-umami-event-to={l}>
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      <ul class="inline">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <details class="menu">
        <summary class="pill dark">{t(locale, "nav.menu")}</summary>
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </details>
      <a class="pill cta" href={`${home}#contact`} data-umami-event="cta" data-umami-event-place="header">{t(locale, "cta")}</a>
    </nav>
  </div>
</header>

<script>
  // Close the menu after picking a link or clicking outside it.
  const menu = document.querySelector<HTMLDetailsElement>("details.menu");
  document.addEventListener("click", (e) => {
    if (menu?.open && (!menu.contains(e.target as Node) || (e.target as Element).closest("a"))) menu.open = false;
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
  }
  header .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 20px;
  }
  .brand {
    font: 500 22px/1 var(--display);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .langs {
    display: flex;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px;
  }
  .langs a {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--ink-muted);
    padding: 9px 10px;
    border-radius: 999px;
  }
  .langs a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
  .inline {
    display: none;
    gap: 4px;
    margin: 0 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .inline a {
    display: block;
    padding: 10px 12px;
    border-radius: 999px;
    text-decoration: none;
    font: 500 15px/1 var(--sans);
    color: var(--ink-muted);
    transition: color 0.2s var(--ease);
  }
  .inline a:hover {
    color: var(--ink);
  }
  @media (min-width: 1080px) {
    .inline {
      display: flex;
    }
    .menu {
      display: none;
    }
  }
  .menu {
    position: relative;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    margin: 0;
    padding: 8px;
    list-style: none;
    min-width: 200px;
    background: var(--surface);
    border-radius: 16px;
    box-shadow: 0 12px 32px rgb(17 19 24 / 0.12);
  }
  .menu a {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    font: 500 17px/1.2 var(--display);
  }
  .menu a:hover {
    background: var(--paper);
  }
  @media (max-width: 560px) {
    .brand {
      font-size: 18px;
      white-space: nowrap;
    }
    .actions {
      gap: 6px;
    }
    .actions .pill {
      padding: 12px;
      letter-spacing: 0.04em;
    }
    .langs a {
      padding: 8px 7px;
    }
    .actions .pill.cta {
      display: none;
    }
  }
</style>
