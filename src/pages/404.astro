---
import Base from "../layouts/Base.astro";
import { locales, localePath, t } from "../i18n";
---

<Base locale="en" title="404 · Romer Alvarez">
  <main class="wrap flowing">
    <span class="label">404</span>
    {
      locales.map((l) => (
        <section lang={l}>
          <h1>{t(l, "notFound.title")}</h1>
          <p>
            {t(l, "notFound.text")} <a href={localePath(l)}>{t(l, "notFound.home")}</a>
          </p>
        </section>
      ))
    }
  </main>
</Base>

<style>
  main {
    padding-block: 72px 96px;
  }
  section {
    margin-top: 32px;
  }
  section + section h1 {
    font-size: clamp(32px, 4vw, 48px);
    color: var(--ink-muted);
  }
  h1 {
    font-size: clamp(48px, 7vw, 96px);
  }
  p {
    color: var(--ink-muted);
  }
  a {
    color: var(--pipeline-ink);
  }
</style>
