---
import { t, type Locale } from "../i18n";
import { SITE } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer>
  <div class="wrap">
    <span class="label">romeralvarez.me</span>
    <span class="links">
      <a class="label" href={SITE.github} rel="me" data-umami-event="profile" data-umami-event-network="github" data-umami-event-place="footer">GitHub</a>
      <a class="label" href={SITE.linkedin} rel="me" data-umami-event="profile" data-umami-event-network="linkedin" data-umami-event-place="footer">LinkedIn</a>
      <a class="label" href={`mailto:${SITE.email}`} data-umami-event="email" data-umami-event-place="footer">Email</a>
    </span>
    <span class="label">{t(locale, "footer.place")}</span>
  </div>
</footer>

<style>
  footer .wrap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .links {
    display: flex;
    gap: 20px;
  }
  /* Taller hit area for fingers without moving the text. */
  .links a {
    text-decoration: none;
    padding-block: 14px;
    margin-block: -14px;
  }
  .links a:hover {
    color: var(--ink);
  }
</style>
