---
import Base from "./Base.astro";
import { t } from "../i18n";
import { formatDate, postLocale, postUrl, type Post } from "../lib/blog";
import { SITE } from "../site";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const locale = postLocale(post);
const { title, description, pubDate, updatedDate, tags, image } = post.data;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: locale,
  url: new URL(postUrl(post), SITE.url).href,
  image: image ? new URL(image, SITE.url).href : undefined,
  author: { "@type": "Person", name: SITE.name, url: SITE.url },
};
---

<Base locale={locale} title={`${title} · Romer Alvarez`} description={description} image={image} alternates={{ [locale]: postUrl(post) }} jsonLd={jsonLd} type="article">
  <main id="main" class="wrap flowing">
    <a class="back label" href={`/${locale}/blog/`}>{t(locale, "blog.back")}</a>
    <header>
      <time class="label" datetime={pubDate.toISOString()}>{formatDate(pubDate, locale)}</time>
      <h1>{title}</h1>
      {tags.length > 0 && <ul class="tags">{tags.map((tag) => <li>{tag}</li>)}</ul>}
    </header>
    <article class="prose">
      <slot />
    </article>
  </main>
</Base>

<style>
  main {
    padding-block: 48px 96px;
  }
  .back {
    text-decoration: none;
  }
  .back:hover {
    color: var(--pipeline-ink);
  }
  header {
    margin: 40px 0 48px;
    max-width: 22ch;
  }
  header h1 {
    margin-top: 16px;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 1;
    max-width: none;
  }
  header {
    max-width: 900px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .tags li {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--pipeline-soft);
    color: var(--pipeline-ink);
    padding: 8px 10px;
    border-radius: 6px;
  }

  .prose {
    max-width: 720px;
    font-size: 18px;
    line-height: 1.7;
  }
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 2em 0 0.6em;
  }
  .prose :global(h1),
  .prose :global(h2) {
    font-size: clamp(28px, 3vw, 36px);
  }
  .prose :global(h3) {
    font-size: 24px;
  }
  .prose :global(h4) {
    font-size: 20px;
  }
  .prose :global(:is(h1, h2, h3, h4) strong) {
    font-weight: inherit;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2em;
  }
  .prose :global(li) {
    margin: 0.3em 0;
  }
  .prose :global(a) {
    color: var(--pipeline-ink);
    text-underline-offset: 3px;
  }
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em auto;
    border-radius: 12px;
    background: var(--surface);
  }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 0 0 0 1.4em;
    color: var(--ink-muted);
    font-style: italic;
    position: relative;
  }
  .prose :global(blockquote)::before {
    content: "\201C";
    position: absolute;
    left: -0.05em;
    top: -0.15em;
    font: 500 2.4em/1 var(--display);
    color: var(--pipeline);
  }
  .prose :global(:not(pre) > code) {
    font: 500 0.88em var(--mono);
    background: var(--surface);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .prose :global(pre) {
    margin: 1.6em 0;
    padding: 20px;
    border-radius: 12px;
    font: 500 14px/1.6 var(--mono);
    overflow-x: auto;
    border: 1px solid var(--line);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 16px;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 10px 12px;
    text-align: left;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 3em 0;
  }
</style>
